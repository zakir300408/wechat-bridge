{
  "name": "wechat-companion-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICES",
        "class_name": "Device",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Device"],
    },
  ],
  "observability": {
    "enabled": false,
  },
}
